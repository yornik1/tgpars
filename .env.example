# Telegram API credentials — get them at https://my.telegram.org → API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Phone number of the account that is a member of the target group(s), E.164 format.
TG_PHONE=+10000000000

# Where the Telethon user session is stored (read-only listener; never sends messages).
TG_SESSION_PATH=sessions/tgpars

# One-time login only (non-interactive). Leave empty normally.
# Run `python -m tgpars.scripts.login` once: Telegram sends a code to your app;
# paste it here as TG_LOGIN_CODE and run again. Set TG_2FA_PASSWORD too if you
# use two-factor. Clear both after a successful sign-in.
TG_LOGIN_CODE=
TG_2FA_PASSWORD=

# Comma-separated target groups to monitor.
# Accepts @usernames, t.me links, or numeric chat ids (e.g. -1001234567890).
# Leave empty to be prompted / to list available dialogs via tgpars-login.
TG_TARGET_CHATS=

# SQLite database location.
DATABASE_URL=sqlite:///data/tgpars.db

# Polite client behaviour (read-only). Keep modest to avoid account flags.
FLOOD_SLEEP_THRESHOLD=60
